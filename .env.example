# Copy this file to `.env.local` and fill in your own keys.
#   cp .env.example .env.local
#
# Both keys have free tiers — no credit card required.
# Do NOT put real keys in this file — it is a committed template.

# Groq — LLM provider.  Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Tavily — web search tool for real, citable research.  Free key: https://app.tavily.com
TAVILY_API_KEY=
